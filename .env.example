# ── Bootstrap config (everything else lives in the DB and is managed from the admin) ──
NODE_ENV=development
ROLE=all                     # web | worker | all
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# sqlite:./data/cms.db  |  mysql://user:pass@host:3306/cms  |  postgres://user:pass@host:5432/cms
DB_URL=sqlite:./data/cms.db
DB_POOL_MIN=2
DB_POOL_MAX=10

# Required in cluster/production. Optional in dev (falls back to in-process bus + DB sessions).
REDIS_URL=
REDIS_QUEUE_URL=             # defaults to REDIS_URL; use a noeviction instance for BullMQ

# Encrypts secrets stored in the DB (AES-256-GCM). Generate: openssl rand -base64 32
APP_MASTER_KEY=
APP_MASTER_KEY_OLD=          # comma-separated previous keys, for rotation

TRUST_PROXY_HOPS=0           # 1 behind a single ALB
CONFIG_POLL_SECONDS=30       # safety-net poll for missed pub/sub messages
HEARTBEAT_SECONDS=10
SHUTDOWN_DELAY_MS=0          # set to ALB deregistration delay in production (e.g. 15000)
JOB_BACKOFF_MS=2000          # base delay between retries of a failed background job (doubles each attempt)
KEEP_ALIVE_TIMEOUT_MS=65000  # must exceed the ALB idle timeout (60s)

# Where uploaded media is stored. One server: the default is fine. A cluster: point every server at the SAME shared volume (EFS/NFS).
MEDIA_DIR=./data/media

# This server's local copy (mirror) of the site tree: pages/ and components/. The DATABASE is the source of truth, so every server
# keeps its own folder; do not share it. Hand edits are kept as .local files; save them with `npm run cli -- site:push`.
SITE_DIR=./public

# Read-only env overrides of any DB setting:  CFG__<namespace>__<key>=value
# CFG__general__maintenance_mode=true

# Single-node production (no Redis / SQLite): explicit opt-in
ALLOW_SINGLE_NODE=false
