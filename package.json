{
  "name": "logiks-webcms-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Cluster-ready CMS + eCommerce platform built on Node.js, Express, and TailwindCSS.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "env": "nvm use v24.21.0",
    "start": "node src/server.js",
    "start:web": "ROLE=web node src/server.js",
    "start:worker": "ROLE=worker node src/server.js",
    "dev": "node --watch src/server.js",
    "setup": "node src/cli/index.js setup",
    "migrate": "node src/cli/index.js migrate",
    "cli": "node src/cli/index.js",
    "test": "node --test --test-force-exit --test-concurrency=1 \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "adm-zip": "^0.6.1",
    "alpinejs": "^3.17.3",
    "argon2": "^0.45.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "bullmq": "^6.3.8",
    "cheerio": "^1.1.2",
    "codejar": "^4.3.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cron-parser": "^5.10.1",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "knex": "^3.3.0",
    "liquidjs": "^10.29.0",
    "marked": "^14.1.4",
    "monaco-editor": "^0.57.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postcss": "^8.5.31",
    "prismjs": "^1.30.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.1",
    "sanitize-html": "^2.17.7",
    "tailwindcss": "^4.3.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.2",
    "@types/sanitize-html": "^2.16.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "eslint": "^10.11.0",
    "jsdom": "30.1.1",
    "mailparser": "^3.9.28",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.8",
    "smtp-server": "^3.19.13",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3",
    "dictionary-en": "^4.0.0",
    "nspell": "^2.1.5",
    "pdfkit": "^0.20.2",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "postcss-selector-parser": "^7.1.7"
  }
}
